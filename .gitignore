# ==============================================================================
# Obsidian Vault .gitignore
# ==============================================================================

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Obsidian workspace layout & local state
# (Changes constantly on every tab click, file switch, and window resize)
workspace.json
workspace-mobile.json
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json
**/.obsidian/workspace*.json

# Obsidian internal cache & deleted notes trash
.trash/
**/.trash/
.obsidian/cache/
**/.obsidian/cache/

# Extension / AI plugin data folders (sessions, conversation logs, run checkpoints, tokens)
.claudian/
**/.claudian/
.grimoire/
**/.grimoire/

# Obsidian community plugin folders (installed extension scripts & assets)
.obsidian/plugins/
**/.obsidian/plugins/

# Plugin runtime caches and git credentials
**/.obsidian/plugins/**/cache/
**/.obsidian/plugins/**/data/cache/
obsidian_askpass.sh
**/obsidian_askpass.sh

# Node & editor artifacts
node_modules/
**/node_modules/
*.log
.vscode/
.idea/
